{
  "name": "wolf-tower-desktop",
  "version": "0.1.0",
  "description": "Wolf Tower для Windows и macOS",
  "main": "main.js",
  "private": true,
  "author": "Wolf Tower",
  "scripts": {
    "start": "node scripts/prepare.js && electron .",
    "test": "node test/run.js",
    "dist:win": "node scripts/prepare.js && electron-builder --win nsis --publish never",
    "dist:mac": "node scripts/prepare.js && electron-builder --mac dmg --publish never"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.wolftower.desktop",
    "productName": "Wolf Tower",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "src/**"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "directories": {
      "buildResources": "icons",
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "icons/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": {
        "target": "dmg",
        "arch": [
          "x64",
          "arm64"
        ]
      },
      "category": "public.app-category.utilities",
      "icon": "icons/icon.png"
    },
    "afterPack": "scripts/after-pack.js"
  }
}
